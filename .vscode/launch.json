{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Validate Badge App (Current File)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/.github/skills/badge-app-builder/scripts/validate_app.py",
            "args": [
                "${fileDirname}"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false,
            "presentation": {
                "hidden": false,
                "group": "badge",
                "order": 1
            }
        }
    ]
}
